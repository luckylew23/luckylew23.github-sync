{
  "id": "luckylew23.github-sync",
  "version": "0.1.1",
  "engines": { "textus": ">=1.4.3" },
  "platforms": ["desktop"],
  "main": "host.js",
  "icon": "icon.svg",
  "license": "MIT",
  "author": "luckylew23",
  "repository": "https://github.com/luckylew23/luckylew23.github-sync",
  "permissions": [
    "files.read",
    "files.write",
    "network:api.github.com",
    "project.data",
    "background",
    "notifications",
    "hidden:.gitignore"
  ],
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "luckylew23.github-sync.open", "title": "%cmd.open%" },
      { "command": "luckylew23.github-sync.sync", "title": "%cmd.sync%" },
      { "command": "luckylew23.github-sync.push", "title": "%cmd.push%" },
      { "command": "luckylew23.github-sync.pull", "title": "%cmd.pull%" }
    ],
    "menus": {
      "app/plugins": [{ "command": "luckylew23.github-sync.open" }]
    },
    "sidebarTabs": [
      {
        "id": "luckylew23.github-sync.tab",
        "title": "%tab.title%",
        "type": "webview",
        "icon": "icon.svg"
      }
    ],
    "statusItems": [
      {
        "id": "luckylew23.github-sync.status",
        "text": "GitHub",
        "tooltip": "%status.tooltip%",
        "command": "luckylew23.github-sync.open"
      }
    ]
  },
  "l10n": {
    "en": {
      "name": "GitHub Sync",
      "description": "Two-way sync between your local notes folder and a GitHub repository. Push changes on save, pull on a schedule, and resolve conflicts per file.",
      "cmd.open": "Open GitHub Sync",
      "cmd.sync": "Sync Now",
      "cmd.push": "Push to GitHub",
      "cmd.pull": "Pull from GitHub",
      "tab.title": "GitHub Sync",
      "status.tooltip": "GitHub Sync — click to open",
      "panel.title": "GitHub Sync",
      "setup.title": "Connect to GitHub",
      "setup.token": "GitHub Personal Access Token (PAT)",
      "setup.token.hint": "Needs repo scope. Stored securely, never synced.",
      "setup.token.placeholder": "ghp_xxxxxxxxxxxx",
      "setup.connect": "Connect",
      "setup.connecting": "Connecting…",
      "setup.repo": "Repository",
      "setup.repo.placeholder": "owner/repo or pick from list",
      "setup.repo.create": "New repository",
      "setup.repo.create.name": "New repo name",
      "setup.repo.create.private": "Private",
      "setup.branch": "Branch",
      "setup.branch.placeholder": "main",
      "setup.finish": "Finish Setup",
      "setup.finishing": "Setting up…",
      "setup.error.token": "Could not verify the token. Check it has the repo scope.",
      "setup.error.repo": "Could not access that repository. Check the name and your token's permissions.",
      "setup.error.network": "Network error. Check your connection or proxy settings.",
      "setup.first.choice": "Both sides have content. Choose how to start:",
      "setup.first.push": "Push local to remote (overwrite remote)",
      "setup.first.pull": "Pull remote to local (overwrite local)",
      "setup.first.cancel": "Cancel",
      "state.connected": "Connected",
      "state.disconnected": "Not connected",
      "state.syncing": "Syncing…",
      "state.synced": "Up to date",
      "state.error": "Error",
      "state.conflict": "Conflicts",
      "sync.last": "Last sync: {0}",
      "sync.never": "Never synced",
      "sync.ahead": "{0} to push",
      "sync.behind": "{0} to pull",
      "sync.conflicts": "{0} conflicts",
      "action.sync": "Sync Now",
      "action.push": "Push",
      "action.pull": "Pull",
      "action.disconnect": "Disconnect",
      "action.settings": "Settings",
      "conflict.title": "Conflicts",
