{
  "id": "luckylew23.github-sync",
  "name": "%name%",
  "publisher": "luckylew23",
  "version": "0.1.2",
  "engines": {
    "textus": ">=1.4.3"
  },
  "platforms": [
    "desktop"
  ],
  "main": "host.js",
  "icon": "icon.svg",
  "license": "MIT",
  "author": "luckylew23",
  "repository": "https://github.com/luckylew23/luckylew23.github-sync",
  "permissions": [
    "files.read",
    "files.write",
    "network:api.github.com",
    "project.data",
    "background",
    "notifications",
    "hidden:.gitignore"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "luckylew23.github-sync.open",
        "title": "%cmd.open%"
      },
      {
        "command": "luckylew23.github-sync.sync",
        "title": "%cmd.sync%"
      },
      {
        "command": "luckylew23.github-sync.push",
        "title": "%cmd.push%"
      },
      {
        "command": "luckylew23.github-sync.pull",
        "title": "%cmd.pull%"
      }
    ],
    "menus": {
      "app/plugins": [
        {
          "command": "luckylew23.github-sync.open"
        }
      ]
    },
    "sidebarTabs": [
      {
        "id": "luckylew23.github-sync.tab",
        "title": "%tab.title%",
        "type": "webview",
        "icon": "icon.svg"
      }
    ],
    "statusItems": [
      {
        "id": "luckylew23.github-sync.status",
        "text": "GitHub",
        "tooltip": "%status.tooltip%",
        "command": "luckylew23.github-sync.open"
      }
    ]
  },
  "l10n": {
    "en": {
      "name": "GitHub Sync",
      "description": "Two-way sync between your local notes folder and a GitHub repository. Push changes on save, pull on a schedule, and resolve conflicts per file.",
