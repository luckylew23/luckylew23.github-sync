      "error.rateLimit": "GitHub API rate limit reached. Try again later.",
      "error.network": "Network error. Check your connection or proxy.",
      "error.fileTooLarge": "File {0} is too large ({1} MB). Skipped.",
      "error.unknown": "An unexpected error occurred: {0}"
